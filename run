#!/usr/bin/env python3
"""Build and launch the native Mac host from any working directory."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
CAPTURE_LOG = Path('research/evidence/capture/latest.log')


def main():
    parser = argparse.ArgumentParser(
        description='Build and launch Bullet Witch fullscreen on macOS.',
        epilog='Host options pass through, for example: ./run --windowed. '
               'Concept missions default to a nonpersistent DEVELOPMENT '
               'completed-game profile. Use --concept-profile saved to inherit '
               'your saved progression.',
        allow_abbrev=False,
    )
    parser.add_argument(
        '--game', type=Path,
        default=Path(os.environ.get('BULLET_WITCH_GAME_DIR') or
                     Path.home() / 'Games' / 'BulletWitch-Steam'),
        help='read-only Steam installation (default: BULLET_WITCH_GAME_DIR or '
             '~/Games/BulletWitch-Steam)',
    )
    parser.add_argument('--build-only', action='store_true',
                        help='build the host without opening a window')
    parser.add_argument('--capture', action='store_true',
                        help='write diagnostics to '
                             'research/evidence/capture/latest.log')
    parser.add_argument('--developer-views', action='store_true',
                        help='select the diagnostic build configuration; interface pending design')
    options, host_options = parser.parse_known_args()
    if sys.platform != 'darwin':
        parser.error('The native launcher currently supports macOS only.')
    game = options.game.expanduser().resolve()
    executable = ROOT / 'build/host-debug/bullet-witch'
    command = [str(executable), '--game', str(game), *host_options]
    if options.capture:
        command.append('--capture')
        # Keep the real build and host processes, with one retained diagnostic
        # stream. The launcher waits to report failure after fullscreen closes.
        log_path = ROOT / CAPTURE_LOG
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open('w', encoding='utf-8') as log:
            try:
                validate(game, options.build_only)
                build(log, developer_views=options.developer_views)
                if not options.build_only:
                    subprocess.run(command, stdout=log,
                                   stderr=subprocess.STDOUT, check=True)
            except subprocess.CalledProcessError as error:
                print(f'Process failed: {error}', file=log)
                print(f'Capture failed; see {CAPTURE_LOG}.', file=sys.stderr)
                return (error.returncode if error.returncode > 0
                        else 128 - error.returncode)
            except (OSError, RuntimeError) as error:
                print(f'Launch failed: {error}', file=log)
                print(f'Capture failed; see {CAPTURE_LOG}.', file=sys.stderr)
                return 1
        return 0
    # Both build steps must succeed before replacing this process with the host.
    try:
        validate(game, options.build_only)
    except RuntimeError as error:
        parser.error(str(error))
    build(developer_views=options.developer_views)
    if not options.build_only:
        os.execv(executable, command)
    return 0


def validate(game, build_only):
    if not build_only and not (game / 'data/data/stable/stable.rat').is_file():
        raise RuntimeError(f'Game installation not found at {game}. '
                           'Use --game PATH or set BULLET_WITCH_GAME_DIR.')
    if shutil.which('cmake') is None:
        raise RuntimeError('CMake is required. See scripts/README.md for build setup.')


def build(output=None, *, developer_views=False):
    # Explicit OFF prevents a cached developer build from changing normal runs.
    mode = 'ON' if developer_views else 'OFF'
    subprocess.run(['cmake', '--preset', 'host-debug',
                    f'-DBW_DEVELOPER_VIEWS={mode}'], cwd=ROOT, check=True,
                   stdout=output, stderr=subprocess.STDOUT if output else None)
    subprocess.run(['cmake', '--build', '--preset', 'host-debug',
                    '--target', 'bullet-witch', '--parallel', '4'], cwd=ROOT,
                   check=True, stdout=output,
                   stderr=subprocess.STDOUT if output else None)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except OSError:
        sys.exit('Launcher could not open a required file or start a process.')
    except KeyboardInterrupt:
        sys.exit(130)
