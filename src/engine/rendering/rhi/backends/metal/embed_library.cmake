# Writes OUTPUT, a C++ source that defines
# bw::rhi::metal::multi_draw_encode_library() (metal_multi_draw.hpp) over the
# bytes of INPUT, the metallib the Metal toolchain built from
# multi_draw_encode.metal. Run by the build (src/engine/rendering/rhi/
# CMakeLists.txt) with cmake -P; the output is a build product, never
# committed.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "embed_library.cmake needs INPUT and OUTPUT")
endif()
file(READ "${INPUT}" library_hex HEX)
string(LENGTH "${library_hex}" hex_length)
if(hex_length EQUAL 0)
  message(FATAL_ERROR "embed_library.cmake: ${INPUT} is empty")
endif()
math(EXPR byte_count "${hex_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," library_bytes "${library_hex}")
file(WRITE "${OUTPUT}"
"// Generated by embed_library.cmake from the Metal backend's encode kernel
// library; a build product.
#include \"backends/metal/metal_multi_draw.hpp\"

#include <array>
#include <span>

namespace bw::rhi::metal {
namespace {
constexpr std::array<unsigned char, ${byte_count}> kLibrary{${library_bytes}};
} // namespace

std::span<const unsigned char> multi_draw_encode_library() noexcept { return kLibrary; }

} // namespace bw::rhi::metal
")
