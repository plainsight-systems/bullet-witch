include("${BOUNDARY_DIR}/configuration.cmake")
function(check_header consumer name header expected)
  include("${BOUNDARY_DIR}/${consumer}.cmake")
  set(unit "${BOUNDARY_DIR}/${name}.cpp")
  file(WRITE "${unit}" "#include \"${header}\"\n")
  set(arguments "-std=c++${check_standard}" -fsyntax-only)
  separate_arguments(global_flags NATIVE_COMMAND "${check_global_flags}")
  separate_arguments(config_flags NATIVE_COMMAND "${check_config_flags}")
  list(APPEND arguments ${global_flags} ${config_flags} ${check_options})
  foreach(architecture IN LISTS check_architectures)
    list(APPEND arguments -arch "${architecture}")
  endforeach()
  foreach(directory IN LISTS check_includes)
    list(APPEND arguments "-I${directory}")
  endforeach()
  foreach(definition IN LISTS check_definitions)
    list(APPEND arguments "-D${definition}")
  endforeach()
  execute_process(COMMAND "${check_compiler}" ${arguments} "${unit}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${BOUNDARY_DIR}/${name}.txt" "${output}${error}")
  if(expected STREQUAL "visible")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${consumer} must see ${header}: ${error}")
    endif()
  else()
    string(FIND "${error}" "'${header}' file not found" missing)
    if(result EQUAL 0 OR missing EQUAL -1)
      message(FATAL_ERROR "${consumer} must reject ${header} itself: ${error}")
    endif()
  endif()
  message(STATUS "Include boundary ${consumer}: ${header} ${expected}")
endfunction()
check_header(engine_host runtime_api bw/runtime/engine_loop.hpp visible)
check_header(engine_host allocator_facade bw/memory/allocator.hpp visible)
check_header(math_register_tests simd_api bw/math/simd/register.hpp visible)
check_header(math_register_tests vector_api bw/math/vector/vector3.hpp visible)
check_header(engine_host private_binned binned/binned_allocator.hpp hidden)
check_header(engine_host private_crash crash_allocator.hpp hidden)
check_header(engine_host private_checks allocator_checks.hpp hidden)
check_header(engine_host private_task_storage task_storage.hpp hidden)
check_header(engine_host unlinked_math bw/math/simd/register.hpp hidden)
check_header(math_register_tests unlinked_allocator bw/memory/allocator.hpp hidden)
