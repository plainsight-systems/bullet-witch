{
  "C_Cpp.clang_format_path": "${workspaceFolder}/scripts/clang-format",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/host-debug/compile_commands.json",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "cmake.useCMakePresets": "always",
  "files.associations": {
    "*.metal": "cpp",
    "*.metal.h": "cpp"
  },
  "[objective-cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "C_Cpp.files.exclude": {
    "**/.vscode": true,
    "**/.vs": true,
    "**/research/vendor/**": true
  },
  "C_Cpp.codeAnalysis.exclude": {
    "**/research/vendor/**": true
  },
  "files.exclude": {
    "**/research/vendor/**": true
  },
  "omnisharp.projectFilesExcludePattern": "**/node_modules/**,**/.git/**,**/bower_components/**,**/research/vendor/**",
  "dotnet.defaultSolution": "disable"
}
